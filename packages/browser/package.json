      "default": "./dist/browser-mcp.js"
    },
    "./own-browser": {
      "agentcomputer-source": "./src/own-browser.ts",
      "types": "./dist/own-browser.d.ts",
      "default": "./dist/own-browser.js"
    },
    "./playwright": {
      "agentcomputer-source": "./src/playwright.ts",
      "types": "./dist/playwright.d.ts",
