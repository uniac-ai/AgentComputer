      "types": "./dist/browser-host.d.ts",
      "default": "./dist/browser-host.js"
    },
    "./browser-live": {
      "agentcomputer-source": "./src/browser-live.ts",
      "types": "./dist/browser-live.d.ts",
      "default": "./dist/browser-live.js"
    },
    "./browser-mcp": {
      "agentcomputer-source": "./src/browser-mcp.ts",
