{
  "name": "@agentorg/computer",
  "version": "0.0.14",
  "description": "Computers for agents, as a service: a terminal, files and a browser over MCP",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniac-ai/AgentComputer.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "agentcomputer": "dist/agentcomputer.js"
  },
  "files": [
    "dist/agentcomputer.js",
    "dist/sdk.js",
    "dist/types",
    "dist/THIRD_PARTY_LICENSES.txt",
    "NOTICE"
  ],
  "scripts": {
    "generate": "node scripts/generate.js",
    "build": "tsc -p tsconfig.json && node scripts/bundle.js",
    "check": "biome check .",
    "test": "npm run build && node --test --test-timeout=60000 \"out/test/**/*.test.js\""
  },
  "dependencies": {
    "playwright-core": "1.65.0-alpha-2026-10-30"
  },
  "devDependencies": {
    "@agentorg/exec": "0.0.7",
    "@biomejs/biome": "2.6.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@playwright/mcp": "0.0.84",
    "@types/node": "^22.20.5",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "openapi-fetch": "0.17.0",
    "typescript": "^7.0.2",
    "ws": "8.22.2",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "types": "./dist/types/sdk.d.ts",
      "default": "./dist/sdk.js"
    }
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
